{"is_source_file": true, "format": "bash/shell script", "description": "This file is a startup/shutdown script for MongoDB used in UPSTDC's tourism monitoring system. It initializes the database environment, ensures the database and user setup, applies JSON schema validations, indexes, seeds initial data, and outputs connection info.", "external_files": ["schema/collections.json", "schema/indexes.js", "seed/seed_data.js"], "external_methods": ["mongosh", "mongod"], "published": ["db_connection.txt", "db_visualizer/mongodb.env"], "classes": [], "methods": [{"name": "wait_for_mongo", "description": "Function to wait until MongoDB is responsive by pinging it repeatedly with a backoff delay"}], "calls": ["mongosh --host 127.0.0.1 --port ${DB_PORT} --eval 'db.adminCommand(\"ping\")'", "mongosh --host 127.0.0.1 --port ${DB_PORT} --eval 'use admin'", "mongosh --host 127.0.0.1 --port ${DB_PORT} --eval 'use ${DB_NAME}'", "mongosh --host 127.0.0.1 --port ${DB_PORT} ${DB_NAME}", "mongod --dbpath ${DBPATH} --port ${DB_PORT} --bind_ip 0.0.0.0 --unixSocketPrefix ${SOCKDIR}"], "search-terms": ["MongoDB startup", "database initialization script", "schema validation", "index creation", "seed data", "UPSTDC", "start script"], "state": 2, "file_id": 3, "knowledge_revision": 32, "git_revision": "b0e6f8a081952d11598a2cef8af3103df61f2d62", "revision_history": [{"11": "962083e65314e9f2917a17b1f01d669a78525f80"}, {"21": "962083e65314e9f2917a17b1f01d669a78525f80"}, {"24": "79499fe5be80b7598df61410b5587c4f64de3465"}, {"31": "ec0453cb074d8f99aaf3271bff3ab273f6adfd42"}, {"32": "b0e6f8a081952d11598a2cef8af3103df61f2d62"}], "hash": "5a9f26b427e2abfbc9333cd2d3bd11d0", "format-version": 4, "code-base-name": "upstdc_database", "filename": "upstdc_database/startup.sh"}